// LimsQual — Controle de Qualidade para Indústria de Bebidas
// Schema Prisma — conforme spec em docs/spec-original.txt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Produção: Postgres no Neon (lims-qualidade.vercel.app).
  // Para dev local: ou aponta DATABASE_URL pro Neon (free tier),
  // ou puxa via `npx vercel env pull .env`.
  // Para usar sqlite local temporário, troque provider para "sqlite"
  // e DATABASE_URL para "file:./dev.db" — apenas em dev, NUNCA commitar.
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ANALISTA") // ADMIN | RESPONSAVEL_TECNICO | ANALISTA | LEITURA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id          String    @id @default(cuid())
  razaoSocial String
  cnpj        String    @unique
  responsavel String
  email       String
  telefone    String
  amostras    Amostra[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Produto {
  id             String          @id @default(cuid())
  nome           String
  codigo         String          @unique
  tipo           String // BEBIDA_ALCOOLICA | NAO_ALCOOLICA | AGUA | MATERIA_PRIMA | EMBALAGEM
  sabor          String?         // p/ refrigerantes: Cola, Guarana, Laranja, Limao, etc.
  volume         Float?          // ml — 200, 350, 600, 1000, 1500, 2000, 3000
  tipoEmbalagem  String?         // PET | VIDRO_RETORNAVEL | VIDRO_NAO_RETORNAVEL | LATA
  versao         String?         // REGULAR | DIET | LIGHT | ZERO_ACUCAR | ZERO_SODIO
  validadeDias   Int?            // shelf life em dias
  especificacoes Especificacao[]
  amostras       Amostra[]
  lotes          Lote[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Especificacao {
  id         String  @id @default(cuid())
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId  String
  parametro  String
  tipo       String  @default("FISICOQUIMICO") // FISICOQUIMICO | MICROBIOLOGICO | SENSORIAL
  minimo     Float?
  maximo     Float?
  unidade    String
  metodo     String?
  legislacao String?

  @@index([produtoId])
  @@index([tipo])
}

model PontoColeta {
  id         String    @id @default(cuid())
  nome       String
  tipo       String // MATERIA_PRIMA | PROCESSO | PRODUTO_ACABADO | AGUA | CIP | AMBIENTE
  localizacao String?
  amostras   Amostra[]
  createdAt  DateTime  @default(now())
}

model Lote {
  id                  String   @id @default(cuid())
  numero              String   @unique
  produto             Produto  @relation(fields: [produtoId], references: [id])
  produtoId           String
  sabor               String?
  dataInicioProducao  DateTime
  dataFimProducao     DateTime?
  volumeTotal         String?  // ex: "5000L", "12000un"
  unidadesProduzidas  Int?     // contagem de unidades
  linha               String?  // Linha 1, Linha 2...
  turno               String?  // MANHA | TARDE | NOITE
  responsavelProducao String?
  status              String   @default("EM_PRODUCAO") // EM_PRODUCAO | FINALIZADO | LIBERADO | RETIDO | DESCARTADO | AGUARDANDO_ANALISE | APROVADO | REPROVADO | REPROCESSO | EXPEDIDO
  observacoes         String?
  amostras            Amostra[]
  consumos            ConsumoInsumo[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([produtoId])
  @@index([status])
}

model Amostra {
  id              String      @id @default(cuid())
  numeroOS        String      @unique
  cliente         Cliente     @relation(fields: [clienteId], references: [id])
  clienteId       String
  produto         Produto     @relation(fields: [produtoId], references: [id])
  produtoId       String
  lote            Lote        @relation(fields: [loteId], references: [id])
  loteId          String
  pontoColeta     PontoColeta? @relation(fields: [pontoColetaId], references: [id])
  pontoColetaId   String?
  loteInsumo      LoteInsumo? @relation(fields: [loteInsumoId], references: [id])
  loteInsumoId    String?
  embalagem       Embalagem?  @relation(fields: [embalagemId], references: [id])
  embalagemId     String?
  tipoAnalise     String // ROTINA | RETENCAO | REPROCESSO | AUDITORIA | RECLAMACAO | XAROPE_SIMPLES | XAROPE_COMPOSTO | INSUMO | EMBALAGEM | AGUA | CIP | SWAB | AR
  status          String      @default("RECEBIDA") // RECEBIDA | EM_ANALISE | AGUARDANDO_APROVACAO | APROVADO | LAUDO_EMITIDO
  quantidade      Int         @default(1)
  volume          String?
  tempTransporte  Float?
  integridadeOk   Boolean     @default(true)
  responsavelColeta String?
  dataColeta      DateTime
  dataRecebimento DateTime    @default(now())
  prazoEntrega    DateTime
  resultados      Resultado[]
  ncs             NaoConformidade[]
  laudo           Laudo?
  registrosCIP    RegistroCIP[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([clienteId])
  @@index([produtoId])
  @@index([loteId])
  @@index([loteInsumoId])
  @@index([embalagemId])
  @@index([status])
}

model Resultado {
  id           String      @id @default(cuid())
  amostra      Amostra     @relation(fields: [amostraId], references: [id], onDelete: Cascade)
  amostraId    String
  parametro    String
  valor        Float
  unidade      String
  metodo       String?
  conformidade String // CONFORME | NAO_CONFORME | ATENCAO
  analista     String
  equipamento  Equipamento? @relation(fields: [equipamentoId], references: [id])
  equipamentoId String?
  dataEnsaio   DateTime    @default(now())
  nc           NaoConformidade?

  @@index([amostraId])
  @@index([parametro])
}

model NaoConformidade {
  id           String     @id @default(cuid())
  numero       String     @unique
  amostra      Amostra    @relation(fields: [amostraId], references: [id])
  amostraId    String
  // Vínculo 1:1 opcional com Resultado (spec).
  // NCs antigas ficam apenas com amostraId; NCs criadas a partir
  // de um resultado fora-de-especificação populam resultadoId.
  resultado    Resultado? @relation(fields: [resultadoId], references: [id])
  resultadoId  String?    @unique
  // NCs também podem ter origem em uma auditoria formal (item do checklist).
  itemAuditoria ItemAuditoria?
  parametro    String
  valorObtido  Float
  limite       String
  descricao    String
  causaRaiz    String?
  // Disposição imediata: LIBERAR | RETER | REPROCESSAR | DESCARTE
  // (também aceito como "disposicao" para alinhar com spec — mesma semântica)
  acao         String
  acaoCorretiva String?
  responsavel  String
  prazo        DateTime
  status       String     @default("ABERTA") // ABERTA | EM_TRATAMENTO | ENCERRADA
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([amostraId])
  @@index([status])
}

model Equipamento {
  id                String      @id @default(cuid())
  nome              String
  modelo            String
  numeroSerie       String      @unique
  fabricante        String?
  ultimaCalibracao  DateTime
  proximaCalibracao DateTime
  certificadoUrl    String?
  status            String // CALIBRADO | VENCIDO | PROXIMO_VENCIMENTO
  resultados        Resultado[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
}

model Laudo {
  id              String   @id @default(cuid())
  numero          String   @unique // L-2026-NNNN
  amostra         Amostra  @relation(fields: [amostraId], references: [id])
  amostraId       String   @unique
  conclusao       String   // APROVADO | REPROVADO | APROVADO_COM_RESTRICOES
  observacoes     String?
  emitidoPorId    String
  emitidoPorNome  String
  emitidoPorRole  String
  dataEmissao     DateTime @default(now())
  qrToken         String   @unique
  createdAt       DateTime @default(now())

  @@index([numero])
}

// =========================================================
// Módulos especializados — indústria de bebidas
// Fornecedor, Insumo, LoteInsumo, ConsumoInsumo,
// Embalagem, RegistroCIP
// =========================================================

model Fornecedor {
  id            String   @id @default(cuid())
  razaoSocial   String
  cnpj          String   @unique
  responsavel   String
  email         String
  telefone      String
  endereco      String?
  certificacoes String?  // ISO 22000 / FSSC / BPF — texto livre por enquanto
  insumos       Insumo[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Insumo {
  id           String       @id @default(cuid())
  nome         String
  codigo       String       @unique
  // AGUA | ACUCAR | HFCS | CO2 | CONCENTRADO | ESSENCIA |
  // EDULCORANTE | ACIDULANTE | CONSERVANTE | CORANTE | OUTRO
  tipo         String
  fornecedor   Fornecedor   @relation(fields: [fornecedorId], references: [id])
  fornecedorId String
  unidadePadrao String      @default("kg") // kg | L | m3 | un
  lotes        LoteInsumo[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([fornecedorId])
  @@index([tipo])
}

model LoteInsumo {
  id              String          @id @default(cuid())
  insumo          Insumo          @relation(fields: [insumoId], references: [id])
  insumoId        String
  loteFornecedor  String          // número do lote no fornecedor
  dataFabricacao  DateTime
  dataValidade    DateTime
  quantidade      Float
  unidade         String          // kg | L | m3 | un
  certificadoUrl  String?         // PDF do CoA do fornecedor (upload futuro)
  status          String          @default("EM_ANALISE") // EM_ANALISE | APROVADO | REPROVADO | QUARENTENA
  observacoes     String?
  amostras        Amostra[]
  consumos        ConsumoInsumo[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([insumoId])
  @@index([status])
  @@index([dataValidade])
}

// Rastreabilidade bidirecional: dado um lote de produção,
// quais insumos foram consumidos; dado um lote de insumo,
// em quais produções foi usado.
model ConsumoInsumo {
  id           String     @id @default(cuid())
  lote         Lote       @relation(fields: [loteId], references: [id])
  loteId       String
  loteInsumo   LoteInsumo @relation(fields: [loteInsumoId], references: [id])
  loteInsumoId String
  quantidade   Float
  unidade      String
  createdAt    DateTime   @default(now())

  @@index([loteId])
  @@index([loteInsumoId])
}

model Embalagem {
  id              String    @id @default(cuid())
  tipo            String    // PET | VIDRO_RETORNAVEL | VIDRO_NAO_RETORNAVEL | LATA | TAMPA | ROTULO
  fornecedor      String    // nome livre por enquanto (pode virar relation depois)
  loteFornecedor  String
  volumeNominalMl Float?    // ml — para PET / vidro / lata
  pesoGramas      Float?    // garrafa PET
  espessuraMm     Float?    // parede PET
  resistenciaBar  Float?    // pressão interna PET
  torqueNcm       Float?    // tampa
  numeroTrips     Int?      // vidro retornável: nº de usos
  status          String    @default("EM_ANALISE") // EM_ANALISE | APROVADA | REPROVADA | DESCARTE
  observacoes     String?
  amostras        Amostra[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tipo])
  @@index([status])
}

// Clean-In-Place: limpeza de tanques, linhas, equipamentos.
// Pode estar vinculado a uma amostra microbiológica que comprove eficácia.
model RegistroCIP {
  id              String   @id @default(cuid())
  alvo            String   // Tanque Xarope Simples | Linha 1 | Enchedora | CIP Geral...
  responsavel     String
  concentracao    Float    // % solução
  temperatura     Float    // °C
  tempoContatoMin Int      // minutos
  resultadoMicro  String?  // observação rápida (resultado da amostra está em Amostra)
  amostra         Amostra? @relation(fields: [amostraId], references: [id])
  amostraId       String?
  status          String   // APROVADO | REPROCESSAR
  observacoes     String?
  data            DateTime @default(now())

  @@index([status])
  @@index([data])
}

// =========================================================
// Configuração do laboratório (singleton)
// Aplicada no cabeçalho/rodapé de TODOS os laudos e relatórios
// =========================================================
model ConfiguracaoLaboratorio {
  id                String    @id @default(cuid())
  razaoSocial       String
  nomeFantasia      String?
  cnpj              String
  inscricaoEstadual String?
  endereco          String
  cep               String
  cidade            String
  estado            String
  telefone          String
  email             String
  site              String?
  logoUrl           String?

  // Responsável Técnico
  rtNome            String
  rtFormacao        String    // FARMACEUTICO | QUIMICO | BIOLOGO | ENG_ALIMENTOS | OUTRO
  rtRegistro        String    // ex: CRQ-IV-12345
  rtAssinaturaUrl   String?

  // Autorizações
  mapaNumero         String?
  mapaValidade       DateTime?
  anvisaNumero       String?
  anvisaValidade     DateTime?
  inmetroNumero      String?   // CRL
  inmetroValidade    DateTime?
  inmetroEscopo      String?
  vigilanciaNumero   String?
  vigilanciaOrgao    String?
  vigilanciaValidade DateTime?
  ibamaNumero        String?
  outrosRegistros    String?   // JSON livre

  updatedAt          DateTime  @updatedAt
}

// =========================================================
// Auditorias formais (BPF, ISO, ANVISA, MAPA, etc.)
// Diferente da trilha de logs (AuditLog) — estas são eventos.
// =========================================================
model Auditoria {
  id                String          @id @default(cuid())
  numero            String          @unique // AUD-2026-NNNN
  tipo              String          // INTERNA | EXTERNA
  norma             String          // BPF | ISO_22000 | FSSC_22000 | ISO_17025 | ANVISA | MAPA | INTERNA
  orgao             String?         // só EXTERNA: ANVISA | MAPA | INMETRO | VIG_SANITARIA | CLIENTE | CERTIFICADORA
  auditorNome       String
  auditorCredencial String?
  dataInicio        DateTime
  dataFim           DateTime?
  areas             String          @default("") // CSV — Higiene, Pragas, Rastreabilidade, Calibracao, Documentacao, Treinamento, Instalacoes
  status            String          @default("PLANEJADA") // PLANEJADA | EM_ANDAMENTO | CONCLUIDA | AGUARDANDO_VERIFICACAO
  resultado         String?         // APROVADO | APROVADO_COM_RESSALVAS | REPROVADO
  relatorioUrl      String?         // upload do PDF do órgão
  prazoResposta     DateTime?
  observacoes       String?
  itens             ItemAuditoria[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([tipo])
  @@index([norma])
}

model ItemAuditoria {
  id          String           @id @default(cuid())
  auditoria   Auditoria        @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  auditoriaId String
  area        String           // Higiene | Pragas | Rastreabilidade | etc.
  item        String           // descrição do item verificado
  resultado   String           // CONFORME | NAO_CONFORME | NAO_APLICAVEL | OBSERVACAO
  observacao  String?
  nc          NaoConformidade? @relation(fields: [ncId], references: [id])
  ncId        String?          @unique

  @@index([auditoriaId])
  @@index([resultado])
}

// Trilha de auditoria para compliance MAPA / ISO 17025.
// Append-only: nunca atualizar ou deletar registros.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  userRole   String?
  action     String   // CREATE | UPDATE | DELETE | SIGN | APPROVE | LOGIN | LOGOUT
  entity     String   // Cliente | Produto | Lote | Amostra | Resultado | NC | Laudo | Equipamento | User
  entityId   String?
  diff       String?  // JSON: { before, after } ou payload da ação
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}
