// LimsQual — Controle de Qualidade para Indústria de Bebidas
// Schema Prisma — conforme spec em docs/spec-original.txt

generator client {
  provider = "prisma-client-js"
}

datasource db {
  // Produção: Postgres no Neon.
  // Dev local: ou puxa DATABASE_URL do Neon (`npx vercel env pull .env`),
  // ou troca provider para "sqlite" + DATABASE_URL="file:./dev.db" localmente
  // (NUNCA commitar essa troca — o build do Vercel exige postgresql).
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  role      String   @default("ANALISTA") // ADMIN | RESPONSAVEL_TECNICO | ANALISTA | LEITURA
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Cliente {
  id          String        @id @default(cuid())
  razaoSocial String
  cnpj        String        @unique
  responsavel String
  email       String
  telefone    String
  // Dados comerciais (Zip 5).
  tipo               String?  // DISTRIBUIDOR | ATACADISTA | VAREJISTA | CONSUMIDOR_FINAL | EXPORTACAO
  limiteCredito      Float?
  condicaoPagamento  String?  // AVISTA | 30 | 60 | 90
  vendedorResponsavel String?
  // Contatos múltiplos (RT é o mais importante p/ envio de laudos).
  contatoRtNome     String?
  contatoRtEmail    String?
  contatoRtTelefone String?
  contatoFinNome    String?
  contatoFinEmail   String?
  contatoFinTelefone String?
  contatoLaudoEmail String?  // e-mail dedicado p/ receber laudos
  // Documentos do cliente.
  alvaraUrl         String?
  alvaraValidade    DateTime?
  vigilanciaUrl     String?
  vigilanciaValidade DateTime?
  contratoUrl       String?
  ativo              Boolean       @default(true)
  amostras    Amostra[]
  portalUsers ClienteUser[]
  movimentacoes MovimentacaoEstoque[]
  sacs        SAC[]
  recallRetornos RecallRetorno[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

// =========================================================
// MÓDULO 13 — PORTAL DO CLIENTE
// Login dedicado por cliente; vê apenas os próprios laudos.
// Auth separada do User interno (provider "cliente-credentials").
// =========================================================
model ClienteUser {
  id        String   @id @default(cuid())
  cliente   Cliente  @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  clienteId String
  email     String   @unique
  password  String
  nome      String
  ativo     Boolean  @default(true)
  ultimoLogin DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clienteId])
  @@index([ativo])
}

model Produto {
  id             String          @id @default(cuid())
  nome           String
  codigo         String          @unique
  tipo           String // BEBIDA_ALCOOLICA | NAO_ALCOOLICA | AGUA | MATERIA_PRIMA | EMBALAGEM
  sabor          String?         // p/ refrigerantes: Cola, Guarana, Laranja, Limao, etc.
  volume         Float?          // ml — 200, 350, 600, 1000, 1500, 2000, 3000
  tipoEmbalagem  String?         // PET | VIDRO_RETORNAVEL | VIDRO_NAO_RETORNAVEL | LATA
  versao         String?         // REGULAR | DIET | LIGHT | ZERO_ACUCAR | ZERO_SODIO
  validadeDias   Int?            // shelf life em dias
  // Registro MAPA do produto (Decreto 6.871/2009, Art. 8º — PIQ).
  mapaProdutoNumero    String?
  mapaProdutoData      DateTime?
  mapaProdutoValidade  DateTime?
  // Checklist de rotulagem (Decreto 6.871/2009, Arts. 10-13).
  // Salvo como JSON: { denominacao: bool, registro: bool, ... }.
  rotulagemChecklist   String?
  rotulagemStatus      String?   // APROVADA | PENDENTE_AJUSTE | EM_ANALISE_MAPA
  rotulagemArteUrl     String?
  especificacoes Especificacao[]
  amostras       Amostra[]
  lotes          Lote[]
  cartas         CartaControle[]
  declaracoes    DeclaracaoAnual[]
  formulacoes    Formulacao[]
  rotulos        Rotulo[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Especificacao {
  id         String  @id @default(cuid())
  produto    Produto @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId  String
  parametro  String
  tipo       String  @default("FISICOQUIMICO") // FISICOQUIMICO | MICROBIOLOGICO | SENSORIAL
  minimo     Float?
  maximo     Float?
  unidade    String
  metodo     String?
  legislacao String?

  @@index([produtoId])
  @@index([tipo])
}

model PontoColeta {
  id         String    @id @default(cuid())
  nome       String
  tipo       String // MATERIA_PRIMA | PROCESSO | PRODUTO_ACABADO | AGUA | CIP | AMBIENTE
  localizacao String?
  amostras   Amostra[]
  createdAt  DateTime  @default(now())
}

model Lote {
  id                  String   @id @default(cuid())
  numero              String   @unique // formato auto: ANO-SEQ-CODPROD-VOL-LINHA
  produto             Produto  @relation(fields: [produtoId], references: [id])
  produtoId           String
  sabor               String?
  dataInicioProducao  DateTime
  dataFimProducao     DateTime?
  dataValidade        DateTime? // calculada: dataInicioProducao + Produto.validadeDias
  // Snapshot p/ rastreabilidade MAPA — preserva valor da data do lote.
  codigoProduto       String?
  registroMAPAProduto String?
  registroMAPAEstab   String?
  volumeTotal         String?  // ex: "5000L", "12000un"
  unidadesProduzidas  Int?     // contagem de unidades
  linha               String?  // Linha 1, Linha 2...
  turno               String?  // MANHA | TARDE | NOITE
  responsavelProducao String?
  status              String   @default("EM_PRODUCAO") // EM_PRODUCAO | FINALIZADO | LIBERADO | RETIDO | DESCARTADO | AGUARDANDO_ANALISE | APROVADO | REPROVADO | REPROCESSO | EXPEDIDO
  observacoes         String?
  // Custos calculados automaticamente a partir dos consumos.
  custoInsumos        Float?
  custoEmbalagens     Float?
  custoTotal          Float?
  custoPorUnidade     Float?
  custoPorLitro       Float?
  amostras            Amostra[]
  consumos            ConsumoInsumo[]
  registrosBPF        RegistroBPF[]
  movimentacoes       MovimentacaoEstoque[]
  avaliacoesSensoriais AvaliacaoSensorial[]
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([produtoId])
  @@index([status])
}

model Amostra {
  id              String      @id @default(cuid())
  numeroOS        String      @unique
  cliente         Cliente     @relation(fields: [clienteId], references: [id])
  clienteId       String
  produto         Produto     @relation(fields: [produtoId], references: [id])
  produtoId       String
  lote            Lote        @relation(fields: [loteId], references: [id])
  loteId          String
  pontoColeta     PontoColeta? @relation(fields: [pontoColetaId], references: [id])
  pontoColetaId   String?
  loteInsumo      LoteInsumo? @relation(fields: [loteInsumoId], references: [id])
  loteInsumoId    String?
  embalagem       Embalagem?  @relation(fields: [embalagemId], references: [id])
  embalagemId     String?
  tipoAnalise     String // ROTINA | RETENCAO | REPROCESSO | AUDITORIA | RECLAMACAO | XAROPE_SIMPLES | XAROPE_COMPOSTO | INSUMO | EMBALAGEM | AGUA | CIP | SWAB | AR
  status          String      @default("RECEBIDA") // RECEBIDA | EM_ANALISE | AGUARDANDO_APROVACAO | APROVADO | LAUDO_EMITIDO
  quantidade      Int         @default(1)
  volume          String?
  tempTransporte  Float?
  integridadeOk   Boolean     @default(true)
  responsavelColeta String?
  dataColeta      DateTime
  dataRecebimento DateTime    @default(now())
  prazoEntrega    DateTime
  resultados      Resultado[]
  ncs             NaoConformidade[]
  laudo           Laudo?
  registrosCIP    RegistroCIP[]
  contraProva     ContraProva?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([clienteId])
  @@index([produtoId])
  @@index([loteId])
  @@index([loteInsumoId])
  @@index([embalagemId])
  @@index([status])
}

model Resultado {
  id           String      @id @default(cuid())
  amostra      Amostra     @relation(fields: [amostraId], references: [id], onDelete: Cascade)
  amostraId    String
  parametro    String
  valor        Float
  unidade      String
  metodo       String?
  conformidade String // CONFORME | NAO_CONFORME | ATENCAO
  analista     String
  equipamento  Equipamento? @relation(fields: [equipamentoId], references: [id])
  equipamentoId String?
  dataEnsaio   DateTime    @default(now())
  nc           NaoConformidade?

  @@index([amostraId])
  @@index([parametro])
}

model NaoConformidade {
  id           String     @id @default(cuid())
  numero       String     @unique
  amostra      Amostra    @relation(fields: [amostraId], references: [id])
  amostraId    String
  // Vínculo 1:1 opcional com Resultado (spec).
  // NCs antigas ficam apenas com amostraId; NCs criadas a partir
  // de um resultado fora-de-especificação populam resultadoId.
  resultado    Resultado? @relation(fields: [resultadoId], references: [id])
  resultadoId  String?    @unique
  // NCs também podem ter origem em uma auditoria formal (item do checklist).
  itemAuditoria ItemAuditoria?
  parametro    String
  valorObtido  Float
  limite       String
  descricao    String
  causaRaiz    String?
  // Disposição imediata: LIBERAR | RETER | REPROCESSAR | DESCARTE
  // (também aceito como "disposicao" para alinhar com spec — mesma semântica)
  acao         String
  acaoCorretiva String?
  responsavel  String
  prazo        DateTime
  status       String     @default("ABERTA") // ABERTA | EM_TRATAMENTO | ENCERRADA
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([amostraId])
  @@index([status])
}

model Equipamento {
  id                String      @id @default(cuid())
  nome              String
  modelo            String
  numeroSerie       String      @unique
  fabricante        String?
  ultimaCalibracao  DateTime
  proximaCalibracao DateTime
  certificadoUrl    String?
  status            String // CALIBRADO | VENCIDO | PROXIMO_VENCIMENTO
  resultados        Resultado[]
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
}

model Laudo {
  id              String   @id @default(cuid())
  numero          String   @unique // L-2026-NNNN
  amostra         Amostra  @relation(fields: [amostraId], references: [id])
  amostraId       String   @unique
  conclusao       String   // APROVADO | REPROVADO | APROVADO_COM_RESTRICOES
  observacoes     String?
  emitidoPorId    String
  emitidoPorNome  String
  emitidoPorRole  String
  dataEmissao     DateTime @default(now())
  qrToken         String   @unique
  createdAt       DateTime @default(now())

  @@index([numero])
}

// =========================================================
// Módulos especializados — indústria de bebidas
// Fornecedor, Insumo, LoteInsumo, ConsumoInsumo,
// Embalagem, RegistroCIP
// =========================================================

model Fornecedor {
  id            String   @id @default(cuid())
  razaoSocial   String
  cnpj          String   @unique
  responsavel   String
  email         String
  telefone      String
  endereco      String?
  certificacoes String?  // ISO 22000 / FSSC / BPF — texto livre por enquanto
  insumos       Insumo[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Insumo {
  id           String       @id @default(cuid())
  nome         String
  codigo       String       @unique
  // AGUA | ACUCAR | HFCS | CO2 | CONCENTRADO | ESSENCIA |
  // EDULCORANTE | ACIDULANTE | CONSERVANTE | CORANTE |
  // DIOXIDO_ENXOFRE | EMULSIFICANTE | ANTIOXIDANTE | AROMATIZANTE | OUTRO
  tipo         String
  fornecedor   Fornecedor   @relation(fields: [fornecedorId], references: [id])
  fornecedorId String
  unidadePadrao String      @default("kg") // kg | L | m3 | un | saca | bombona | cilindro
  lotes        LoteInsumo[]
  especificacoes EspecificacaoInsumo[]
  ingredFormul   FormulacaoIngrediente[]
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@index([fornecedorId])
  @@index([tipo])
}

// Especificações de aprovação do insumo (similar a Especificacao do Produto).
// Define limites min/max que cada lote do insumo precisa atender.
model EspecificacaoInsumo {
  id          String  @id @default(cuid())
  insumo      Insumo  @relation(fields: [insumoId], references: [id], onDelete: Cascade)
  insumoId    String
  parametro   String  // Pureza | Umidade | pH | Pol | Cor (ICUMSA) | etc.
  minimo      Float?
  maximo      Float?
  unidade     String  // % | g/100g | pH | ICUMSA | etc.
  metodo      String?
  obrigatorio Boolean @default(true)

  @@index([insumoId])
}

model LoteInsumo {
  id              String          @id @default(cuid())
  insumo          Insumo          @relation(fields: [insumoId], references: [id])
  insumoId        String
  loteFornecedor  String          // número do lote no fornecedor
  dataFabricacao  DateTime
  dataValidade    DateTime
  quantidade      Float
  unidade         String          // kg | L | m3 | un | saca | bombona | cilindro
  // Recebimento detalhado (Zip 5)
  pesoLiquido     Float?          // kg — para sólidos
  volumeLiquido   Float?          // L — para líquidos
  nrEmbalagens    Int?            // nº de sacas/bombonas/cilindros
  pesoPorEmbalagem Float?         // kg ou L por embalagem
  certificadoUrl  String?         // PDF do CoA do fornecedor (upload futuro)
  status          String          @default("EM_ANALISE") // EM_ANALISE | APROVADO | REPROVADO | QUARENTENA
  observacoes     String?
  // Custos do lote de insumo (R$).
  precoUnitario   Float?
  valorTotal      Float?          // precoUnitario × quantidade
  numeroNF        String?
  dataNF          DateTime?
  condicaoPagamento String?       // AVISTA | 30 | 60 | 90
  amostras        Amostra[]
  consumos        ConsumoInsumo[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([insumoId])
  @@index([status])
  @@index([dataValidade])
}

// Rastreabilidade bidirecional: dado um lote de produção,
// quais insumos foram consumidos; dado um lote de insumo,
// em quais produções foi usado.
model ConsumoInsumo {
  id           String     @id @default(cuid())
  lote         Lote       @relation(fields: [loteId], references: [id])
  loteId       String
  loteInsumo   LoteInsumo @relation(fields: [loteInsumoId], references: [id])
  loteInsumoId String
  quantidade   Float
  unidade      String
  // Custo snapshot: precoUnitario do LoteInsumo no momento do consumo
  // (preserva valor histórico mesmo se o lote de insumo for reprecificado).
  custoUnitario Float?
  custoTotal    Float?    // quantidade × custoUnitario
  createdAt    DateTime   @default(now())

  @@index([loteId])
  @@index([loteInsumoId])
}

model Embalagem {
  id              String    @id @default(cuid())
  tipo            String    // PET | VIDRO_RETORNAVEL | VIDRO_NAO_RETORNAVEL | LATA | TAMPA | ROTULO
  fornecedor      String    // nome livre por enquanto (pode virar relation depois)
  loteFornecedor  String
  volumeNominalMl Float?    // ml — para PET / vidro / lata
  pesoGramas      Float?    // garrafa PET
  espessuraMm     Float?    // parede PET
  resistenciaBar  Float?    // pressão interna PET
  torqueNcm       Float?    // tampa
  numeroTrips     Int?      // vidro retornável: nº de usos
  status          String    @default("EM_ANALISE") // EM_ANALISE | APROVADA | REPROVADA | DESCARTE
  observacoes     String?
  // Custos.
  precoUnitario      Float?
  quantidadeRecebida Float?
  valorTotal         Float?  // precoUnitario × quantidadeRecebida
  numeroNF           String?
  amostras        Amostra[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([tipo])
  @@index([status])
}

// Clean-In-Place: limpeza de tanques, linhas, equipamentos.
// Pode estar vinculado a uma amostra microbiológica que comprove eficácia.
model RegistroCIP {
  id              String   @id @default(cuid())
  alvo            String   // Tanque Xarope Simples | Linha 1 | Enchedora | CIP Geral...
  responsavel     String
  concentracao    Float    // % solução
  temperatura     Float    // °C
  tempoContatoMin Int      // minutos
  resultadoMicro  String?  // observação rápida (resultado da amostra está em Amostra)
  amostra         Amostra? @relation(fields: [amostraId], references: [id])
  amostraId       String?
  status          String   // APROVADO | REPROCESSAR
  observacoes     String?
  data            DateTime @default(now())

  @@index([status])
  @@index([data])
}

// =========================================================
// Configuração do laboratório (singleton)
// Aplicada no cabeçalho/rodapé de TODOS os laudos e relatórios
// =========================================================
model ConfiguracaoLaboratorio {
  id                String    @id @default(cuid())
  razaoSocial       String
  nomeFantasia      String?
  cnpj              String
  inscricaoEstadual String?
  endereco          String
  cep               String
  cidade            String
  estado            String
  telefone          String
  email             String
  site              String?
  logoUrl           String?

  // Responsável Técnico
  rtNome            String
  rtFormacao        String    // FARMACEUTICO | QUIMICO | BIOLOGO | ENG_ALIMENTOS | OUTRO
  rtRegistro        String    // ex: CRQ-IV-12345
  rtAssinaturaUrl   String?

  // Autorizações — Registro MAPA do estabelecimento.
  mapaNumero          String?
  mapaValidade        DateTime?
  mapaDataConcessao   DateTime?
  mapaNumeroProcesso  String?
  mapaSFA             String?   // Superintendência Federal de Agricultura (estado)
  mapaCertificadoUrl  String?
  anvisaNumero       String?
  anvisaValidade     DateTime?
  inmetroNumero      String?   // CRL
  inmetroValidade    DateTime?
  inmetroEscopo      String?
  vigilanciaNumero   String?
  vigilanciaOrgao    String?
  vigilanciaValidade DateTime?
  ibamaNumero        String?
  outrosRegistros    String?   // JSON livre

  updatedAt          DateTime  @updatedAt
}

// =========================================================
// Auditorias formais (BPF, ISO, ANVISA, MAPA, etc.)
// Diferente da trilha de logs (AuditLog) — estas são eventos.
// =========================================================
model Auditoria {
  id                String          @id @default(cuid())
  numero            String          @unique // AUD-2026-NNNN
  tipo              String          // INTERNA | EXTERNA
  norma             String          // BPF | ISO_22000 | FSSC_22000 | ISO_17025 | ANVISA | MAPA | INTERNA
  orgao             String?         // só EXTERNA: ANVISA | MAPA | INMETRO | VIG_SANITARIA | CLIENTE | CERTIFICADORA
  auditorNome       String
  auditorCredencial String?
  dataInicio        DateTime
  dataFim           DateTime?
  areas             String          @default("") // CSV — Higiene, Pragas, Rastreabilidade, Calibracao, Documentacao, Treinamento, Instalacoes
  status            String          @default("PLANEJADA") // PLANEJADA | EM_ANDAMENTO | CONCLUIDA | AGUARDANDO_VERIFICACAO
  resultado         String?         // APROVADO | APROVADO_COM_RESSALVAS | REPROVADO
  relatorioUrl      String?         // upload do PDF do órgão
  prazoResposta     DateTime?
  observacoes       String?
  itens             ItemAuditoria[]
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@index([status])
  @@index([tipo])
  @@index([norma])
}

model ItemAuditoria {
  id          String           @id @default(cuid())
  auditoria   Auditoria        @relation(fields: [auditoriaId], references: [id], onDelete: Cascade)
  auditoriaId String
  area        String           // Higiene | Pragas | Rastreabilidade | etc.
  item        String           // descrição do item verificado
  resultado   String           // CONFORME | NAO_CONFORME | NAO_APLICAVEL | OBSERVACAO
  observacao  String?
  nc          NaoConformidade? @relation(fields: [ncId], references: [id])
  ncId        String?          @unique

  @@index([auditoriaId])
  @@index([resultado])
}

// Trilha de auditoria para compliance MAPA / ISO 17025.
// Append-only: nunca atualizar ou deletar registros.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  userName   String?
  userRole   String?
  action     String   // CREATE | UPDATE | DELETE | SIGN | APPROVE | LOGIN | LOGOUT
  entity     String   // Cliente | Produto | Lote | Amostra | Resultado | NC | Laudo | Equipamento | User
  entityId   String?
  diff       String?  // JSON: { before, after } ou payload da ação
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
}

// =========================================================
// MÓDULO 10 — CEP/SPC (Controle Estatístico de Processo)
// Cartas de Controle X̄ e R; Cp/Cpk; Regras de Nelson.
// Cache recalculável a partir dos Resultados existentes.
// =========================================================
model CartaControle {
  id            String   @id @default(cuid())
  produto       Produto  @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId     String
  parametro     String
  amostras      Int      // n de pontos usados
  media         Float    // X̄ geral (linha central)
  desvio        Float    // σ estimado
  lcs           Float    // média + 3σ
  lc            Float
  lci           Float    // média − 3σ
  lse           Float?   // do cadastro do produto
  lie           Float?
  cp            Float?
  cpk           Float?
  classificacao String?  // CAPAZ | ATENCAO | INCAPAZ
  alertasNelson String?  // CSV — REGRA_1 | REGRA_2 | REGRA_3
  recalculadaEm DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([produtoId, parametro])
  @@index([classificacao])
}

// =========================================================
// MÓDULO 11 — APPCC/HACCP
// Análise de Perigos + Pontos Críticos de Controle.
// Atende ISO 22000, FSSC 22000, RDC 216/ANVISA.
// =========================================================
model PCC {
  id               String             @id @default(cuid())
  numero           String             @unique // PCC-01, PCC-02
  etapa            String             // Pasteurização | Carbonatação | Envase
  perigo           String             // descrição do perigo
  tipoPerigo       String             // BIOLOGICO | QUIMICO | FISICO | RADIOLOGICO
  probabilidade    String             // ALTA | MEDIA | BAIXA
  severidade       String             // ALTA | MEDIA | BAIXA
  medidaControle   String
  limiteCriticoMin Float?
  limiteCriticoMax Float?
  unidade          String
  frequencia       String             // "a cada batelada", "horário"...
  responsavel      String
  acaoCorretiva    String
  ativo            Boolean            @default(true)
  monitoramentos   MonitoramentoPCC[]
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([etapa])
  @@index([ativo])
}

model MonitoramentoPCC {
  id          String   @id @default(cuid())
  pcc         PCC      @relation(fields: [pccId], references: [id], onDelete: Cascade)
  pccId       String
  valor       Float
  conforme    Boolean
  responsavel String
  observacao  String?
  data        DateTime @default(now())

  @@index([pccId])
  @@index([data])
}

// =========================================================
// MÓDULO 12 — DOCUMENTOS + TREINAMENTOS
// Controle de POPs, ITPs, manuais com versionamento.
// Matriz de treinamento colaborador × documento.
// Atende ISO 17025, ISO 22000, FSSC 22000.
// =========================================================
model Documento {
  id                 String        @id @default(cuid())
  codigo             String        // POP-LAB-001
  titulo             String
  tipo               String        // POP | ITP | FORMULARIO | MANUAL | PROCEDIMENTO | ESPECIFICACAO
  versao             String        // 1.0, 2.0
  arquivoUrl         String?
  status             String        @default("VIGENTE") // VIGENTE | OBSOLETO | EM_REVISAO
  aprovadoPor        String
  dataAprovacao      DateTime
  revisaoEm          DateTime?     // próxima revisão programada
  observacoes        String?
  versaoAnterior     Documento?    @relation("Versoes", fields: [versaoAnteriorId], references: [id])
  versaoAnteriorId   String?
  versoesPosteriores Documento[]   @relation("Versoes")
  treinamentos       Treinamento[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([codigo])
  @@index([status])
  @@index([revisaoEm])
}

model Colaborador {
  id           String        @id @default(cuid())
  nome         String
  cpf          String?       @unique
  cargo        String
  setor        String
  email        String?       @unique
  telefone     String?
  dataAdmissao DateTime?
  // Acesso ao sistema (perfil) — espelha o User.role.
  role         String        @default("ANALISTA") // ADMIN | RT | ANALISTA | OPERADOR | LEITURA
  ativo        Boolean       @default(true)
  // Saúde ocupacional (BPF MAPA).
  proximoExame DateTime?
  aptidao      String        @default("APTO")     // APTO | APTO_COM_RESTRICOES | INAPTO
  // Equipamentos que está habilitado a operar (CSV — keep simples).
  equipamentos String?
  treinamentos Treinamento[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([setor])
  @@index([ativo])
}

model Treinamento {
  id            String      @id @default(cuid())
  colaborador   Colaborador @relation(fields: [colaboradorId], references: [id], onDelete: Cascade)
  colaboradorId String
  documento     Documento   @relation(fields: [documentoId], references: [id])
  documentoId   String
  dataRealizado DateTime
  instrutor     String
  forma         String      // PRESENCIAL | ONLINE | ON_THE_JOB
  validade      DateTime?
  status        String      @default("TREINADO") // TREINADO | VENCIDO | EM_DIA
  evidenciaUrl  String?
  observacoes   String?
  createdAt     DateTime    @default(now())

  @@index([colaboradorId])
  @@index([documentoId])
  @@index([status])
  @@index([validade])
}

// =========================================================
// MÓDULO 14 — CONFORMIDADE MAPA (Lei 8.918/94, Decreto 6.871/2009)
// =========================================================

// Registros do estabelecimento e dos produtos no MAPA.
// tipo = ESTABELECIMENTO (1 ativo por vez) | PRODUTO (1 por produto).
model RegistroMAPA {
  id              String   @id @default(cuid())
  tipo            String   // ESTABELECIMENTO | PRODUTO
  numero          String
  dataConcessao   DateTime
  validade        DateTime?
  numeroProcesso  String?
  sfaEstado       String?  // SP | MG | PE | ...
  produtoId       String?  // só preenchido quando tipo = PRODUTO
  documentoUrl    String?
  status          String   @default("ATIVO") // ATIVO | VENCIDO | CANCELADO
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([tipo])
  @@index([produtoId])
  @@index([status])
}

// Declaração Anual de Produção (Decreto 6.871/2009).
// 1 linha por (ano, produto). Envio até 31/jan do ano seguinte.
model DeclaracaoAnual {
  id           String   @id @default(cuid())
  ano          Int
  produto      Produto  @relation(fields: [produtoId], references: [id])
  produtoId    String
  qtdProduzida Float
  qtdVendida   Float
  estoque      Float
  unidade      String   // L | un
  dataEnvio    DateTime?
  status       String   @default("PENDENTE") // PENDENTE | ENVIADA | CONFIRMADA
  observacoes  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([ano, produtoId])
  @@index([ano])
  @@index([status])
}

// Registros de Boas Práticas de Fabricação (Portaria SDA/MAPA 1343/2025).
// Rastreia etapas de elaboração: xarope, carbonatação, envase, etc.
model RegistroBPF {
  id          String   @id @default(cuid())
  lote        Lote?    @relation(fields: [loteId], references: [id])
  loteId      String?
  etapa       String   // XAROPE_SIMPLES | XAROPE_COMPOSTO | CARBONATACAO | ENVASE | HIGIENE | LIMPEZA | TEMPERATURA | PRAGAS
  data        DateTime
  responsavel String
  // Parâmetros específicos da etapa, salvos como JSON.
  // Ex.: { tempC: 4, pressaoBar: 3.5, volCO2: 3.8 }.
  parametros  String?  // JSON
  observacoes String?
  createdAt   DateTime @default(now())

  @@index([loteId])
  @@index([etapa])
  @@index([data])
}

// Contraprova / amostra de retenção (IN MAPA 55/2009).
// 1:1 com Amostra — preserva subamostra física pra auditoria.
model ContraProva {
  id                 String   @id @default(cuid())
  amostra            Amostra  @relation(fields: [amostraId], references: [id])
  amostraId          String   @unique
  codigo             String   @unique
  quantidade         Float
  embalagem          String
  localArmazenamento String
  dataColeta         DateTime
  prazoDescarte      DateTime
  status             String   @default("RETIDA") // RETIDA | DESCARTADA
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([status])
  @@index([prazoDescarte])
}

// =========================================================
// MÓDULO 15 — ZIP 5: Rótulos, Formulação, Sensorial, Água,
// Temperatura, Estoque, Recall, SAC
// =========================================================

// Lote de rótulos recebidos — checklist RDC 259/2002 + Decreto 6.871/2009.
model Rotulo {
  id              String   @id @default(cuid())
  fornecedor      String
  loteFornecedor  String
  produto         Produto  @relation(fields: [produtoId], references: [id])
  produtoId       String
  quantidade      Int
  dataRecebimento DateTime @default(now())
  numeroNF        String?
  // checklist salvo como JSON: { denominacao: "CONFORME"|"NAO_CONFORME"|"NA", ... }
  checklist       String?  // JSON
  status          String   @default("EM_ANALISE") // EM_ANALISE | APROVADO | REPROVADO | APROVADO_COM_RESSALVA
  arteUrl         String?
  observacoes     String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([produtoId])
  @@index([status])
}

// Formulação/receita oficial do produto (vinculada ao registro MAPA).
model Formulacao {
  id            String                  @id @default(cuid())
  produto       Produto                 @relation(fields: [produtoId], references: [id], onDelete: Cascade)
  produtoId     String
  versao        Int                     @default(1)
  vigente       Boolean                 @default(true)
  aprovadaPor   String
  dataAprovacao DateTime
  observacoes   String?
  ingredientes  FormulacaoIngrediente[]
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt

  @@unique([produtoId, versao])
  @@index([produtoId])
}

model FormulacaoIngrediente {
  id           String     @id @default(cuid())
  formulacao   Formulacao @relation(fields: [formulacaoId], references: [id], onDelete: Cascade)
  formulacaoId String
  insumo       Insumo?    @relation(fields: [insumoId], references: [id])
  insumoId     String?
  // Nome livre caso o insumo não esteja cadastrado.
  nomeLivre    String?
  quantidade   Float      // por 1000L de produto
  unidade      String     // kg | L | g | mL
  percentual   Float?
  minimoPerc   Float?
  maximoPerc   Float?
  funcao       String     // acidulante | conservante | corante | edulcorante | aromatizante | outro
  ins          String?    // ex: INS 211
  legislacao   String?
  obrigatorio  Boolean    @default(true)

  @@index([formulacaoId])
}

// Painel sensorial por lote (escala hedônica 1-9).
model AvaliacaoSensorial {
  id          String                    @id @default(cuid())
  lote        Lote                      @relation(fields: [loteId], references: [id])
  loteId      String
  data        DateTime
  resultado   String                    @default("PENDENTE") // APROVADO | REPROVADO | APROVADO_COM_RESSALVA | PENDENTE
  produtoReferencia String?
  observacoes String?
  itens       AvaliacaoSensorialItem[]
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  @@index([loteId])
  @@index([resultado])
}

model AvaliacaoSensorialItem {
  id              String             @id @default(cuid())
  avaliacao       AvaliacaoSensorial @relation(fields: [avaliacaoId], references: [id], onDelete: Cascade)
  avaliacaoId     String
  avaliador       String
  aparencia       Int
  cor             Int
  odor            Int
  sabor           Int
  carbonatacao    Int?
  corpo           Int?
  impressaoGlobal Int
  parecer         String              // APROVADO | REPROVADO | APROVADO_COM_RESSALVA
  desvios         String?
  comparacaoPadrao String?            // IGUAL | SUPERIOR | INFERIOR

  @@index([avaliacaoId])
}

// Controle de água de processo (Portaria GM/MS 888/2021).
model ControleAgua {
  id          String   @id @default(cuid())
  ponto       String
  tipo        String   // DIARIO | MENSAL | SEMESTRAL
  data        DateTime
  // Parâmetros como JSON livre (ex: { cloro: 1.2, pH: 7, turbidez: 0.5 }).
  parametros  String?  // JSON
  responsavel String
  status      String   @default("CONFORME") // CONFORME | ATENCAO | NAO_CONFORME
  laudoUrl    String?  // p/ análises externas semestrais
  numeroLaudo String?
  observacoes String?
  createdAt   DateTime @default(now())

  @@index([tipo])
  @@index([data])
  @@index([status])
}

// Monitoramento de temperatura (Portaria MAPA 1343/2025).
model PontoTemperatura {
  id           String   @id @default(cuid())
  nome         String
  tipo         String   // CAMARA_FRIA | ARMAZEM | AREA_PRODUCAO | CAMARA_RETENCAO
  tempMin      Float
  tempMax      Float
  frequenciaH  Int?     // horas entre registros
  responsavel  String?
  ativo        Boolean  @default(true)
  registros    RegistroTemperatura[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([tipo])
}

model RegistroTemperatura {
  id          String   @id @default(cuid())
  ponto       PontoTemperatura @relation(fields: [pontoId], references: [id], onDelete: Cascade)
  pontoId     String
  temperatura Float
  conforme    Boolean
  responsavel String
  observacoes String?
  data        DateTime @default(now())

  @@index([pontoId])
  @@index([data])
  @@index([conforme])
}

// Estoque e expedição.
model MovimentacaoEstoque {
  id              String   @id @default(cuid())
  tipo            String   // ENTRADA | SAIDA
  lote            Lote     @relation(fields: [loteId], references: [id])
  loteId          String
  quantidade      Float
  unidade         String   // caixas | unidades | L
  cliente         Cliente? @relation(fields: [clienteId], references: [id])
  clienteId       String?
  notaFiscal      String?
  notaFiscalUrl   String?
  transportadora  String?
  placaVeiculo    String?
  temperaturaC    Float?
  localizacao     String?  // posição no armazém (entrada)
  responsavel     String
  data            DateTime @default(now())

  @@index([loteId])
  @@index([clienteId])
  @@index([tipo])
}

// Recall / recolhimento (Decreto 6.871/2009 Art. 80).
model Recall {
  id              String          @id @default(cuid())
  numero          String          @unique // RC-2026-NNN
  // Lista de IDs de Lote afetados — armazenado como CSV pra simplificar.
  lotesIds        String
  motivo          String          // CONTAMINACAO | NC_FISICOQUIMICA | CORPO_ESTRANHO | ROTULAGEM | OUTRO
  descricao       String
  nivel           String          // CLASSE_I | CLASSE_II | CLASSE_III
  status          String          @default("ABERTO") // ABERTO | EM_ANDAMENTO | ENCERRADO
  responsavel     String
  dataIdentificacao DateTime
  dataMAPA        DateTime?
  protocoloMAPA   String?
  qtdRecolhida    Float?
  destinacao      String?         // DESCARTE | REPROCESSO
  dataEncerramento DateTime?
  retornos        RecallRetorno[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([status])
  @@index([nivel])
}

model RecallRetorno {
  id            String   @id @default(cuid())
  recall        Recall   @relation(fields: [recallId], references: [id], onDelete: Cascade)
  recallId      String
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  clienteId     String
  qtdNotificada Float
  qtdRetornada  Float?
  status        String   @default("NOTIFICADO") // NOTIFICADO | RETORNOU | DESCARTOU | NAO_LOCALIZADO
  observacoes   String?
  data          DateTime @default(now())

  @@index([recallId])
  @@index([clienteId])
  @@index([status])
}

// SAC — Reclamação do cliente.
model SAC {
  id          String   @id @default(cuid())
  numero      String   @unique // SAC-2026-NNN
  cliente     Cliente  @relation(fields: [clienteId], references: [id])
  clienteId   String
  produto     String?  // nome do produto reclamado (livre)
  lote        String?  // lote informado pelo cliente
  canal       String   // EMAIL | TELEFONE | WHATSAPP | PRESENCIAL | PORTAL
  tipo        String   // QUALIDADE | CORPO_ESTRANHO | EMBALAGEM | VALIDADE | ROTULAGEM | ATRASO | DOCUMENTACAO | OUTRO
  descricao   String
  urgencia    String   @default("MEDIA") // BAIXA | MEDIA | ALTA | CRITICA
  status      String   @default("ABERTA") // ABERTA | EM_INVESTIGACAO | AGUARDANDO_RETORNO | ENCERRADA
  prazo       DateTime
  causaRaiz   String?
  acao        String?
  resposta    String?
  dataResposta DateTime?
  satisfacaoCliente String? // SATISFEITO | INSATISFEITO | SEM_RETORNO
  evidenciaUrl String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([clienteId])
  @@index([status])
  @@index([urgencia])
}
